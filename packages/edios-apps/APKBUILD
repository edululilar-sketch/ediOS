# ediOS Apps: beliebte Flathub-Apps installieren und entfernen.
# Dateien und Ziele stehen in src/files.map (Gruppe "apps").
pkgname=edios-apps
pkgver=1.0.0   # = EDIOS_PKGVER in config.sh (build/inner.sh prueft das)
pkgrel=0
pkgdesc="ediOS apps helper (install and remove Flathub apps)"
url="https://github.com/edululilar-sketch/ediOS"
arch="noarch"
license="GPL-3.0-or-later"
depends="flatpak py3-gobject3 libadwaita gtk4.0"
options="!check"
source=""

package() {
	sh "$startdir/edios-src/install-map.sh" "$pkgdir" apps
}
