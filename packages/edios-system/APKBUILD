# ediOS System (neu in 1.1): Programme und Einstellungen, die per Update auch zu schon installierten Systemen
# kommen sollen. Dateien und Ziele stehen in src/files.map (Gruppe "sys"). edios-base haengt davon ab.
#   - Dateien: Archive, NTFS/exFAT, Handys (MTP), Codecs, Schriften, alle Uebersetzungen (lang)
#   - Spiele: Controller-Regeln, vm.max_map_count, earlyoom (Schutz vor vollem Arbeitsspeicher)
#   - Zeitzone/Uhr in den GNOME-Einstellungen (openrc-settingsd), Secure-Boot-Hinweis, Dialog-Symbol
#   - einmalige Umstellung nach dem Update (edios-migration), Versionsangabe in /etc/os-release
pkgname=edios-system
pkgver=1.1.0   # = EDIOS_PKGVER in config.sh (build/inner.sh prueft das)
pkgrel=0
_caladea_commit=bed55e0de5cfa8f5fb94f9a1f49409b5ec504469   # google/fonts (wie die Ubuntu-Schrift), Caladea 1.002
pkgdesc="ediOS system (files, codecs, fonts, translations, games, time zone)"
url="https://github.com/edululilar-sketch/ediOS"
arch="noarch"
license="GPL-3.0-or-later AND OFL-1.1 AND LGPL-2.1-or-later"
depends="
	lang
	file-roller 7zip ntfs-3g exfatprogs gvfs-mtp
	gst-libav gst-plugins-ugly gst-plugins-good gst-plugins-bad decibels
	font-liberation font-carlito font-noto-emoji
	earlyoom earlyoom-openrc openrc-settingsd openrc-settingsd-openrc
	zenity mokutil openssl
	"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
options="!check"
source="
	caladea-Caladea-Regular.ttf::https://raw.githubusercontent.com/google/fonts/$_caladea_commit/ofl/caladea/Caladea-Regular.ttf
	caladea-Caladea-Bold.ttf::https://raw.githubusercontent.com/google/fonts/$_caladea_commit/ofl/caladea/Caladea-Bold.ttf
	caladea-Caladea-Italic.ttf::https://raw.githubusercontent.com/google/fonts/$_caladea_commit/ofl/caladea/Caladea-Italic.ttf
	caladea-Caladea-BoldItalic.ttf::https://raw.githubusercontent.com/google/fonts/$_caladea_commit/ofl/caladea/Caladea-BoldItalic.ttf
	caladea-OFL.txt::https://raw.githubusercontent.com/google/fonts/$_caladea_commit/ofl/caladea/OFL.txt
	"

package() {
	local s="$startdir/edios-src"
	sh "$s/install-map.sh" "$pkgdir" sys
	# Versionsangabe (post-install kopiert sie nach /etc/os-release, nur auf ediOS)
	mkdir -p "$pkgdir/usr/share/edios"
	sed "s/@VERSION@/${pkgver%.*}/g; s|@URL@|$url|g" "$s/files/os-release.in" > "$pkgdir/usr/share/edios/os-release"
	# Caladea: metrisch gleich wie Cambria (fontconfig ordnet sie in 30-metric-aliases.conf zu)
	local f
	for f in Regular Bold Italic BoldItalic; do
		install -Dm644 "$srcdir/caladea-Caladea-$f.ttf" "$pkgdir/usr/share/fonts/caladea/Caladea-$f.ttf"
	done
	install -Dm644 "$srcdir/caladea-OFL.txt" "$pkgdir/usr/share/licenses/font-caladea/OFL.txt"
	# Deutsche Sprach-/Laendernamen (iso-codes 4.20.1): Alpines iso-codes-lang enthaelt nur Verweise wie
	# iso_639.mo -> iso_639-2.mo, die Zieldateien fehlen. Hier genau diese Ziele (siehe src/iso-codes-de/LIESMICH.txt).
	local po d
	for po in "$s"/iso-codes-de/*.de.po; do
		d="${po##*/}"; d="${d%.de.po}"
		mkdir -p "$pkgdir/usr/share/locale/de/LC_MESSAGES"
		msgfmt -o "$pkgdir/usr/share/locale/de/LC_MESSAGES/$d.mo" "$po"
	done
	install -Dm644 "$s/iso-codes-de/LGPL-2.1-or-later.txt" "$pkgdir/usr/share/licenses/edios-iso-codes-de/LGPL-2.1-or-later.txt"
	install -Dm644 "$s/iso-codes-de/LIESMICH.txt" "$pkgdir/usr/share/licenses/edios-iso-codes-de/LIESMICH.txt"
}

sha512sums="
