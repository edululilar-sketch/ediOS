def _lang():
    for v in ("LC_ALL", "LC_MESSAGES", "LANG"):
        x = os.environ.get(v, "")
        if x and x != "C" and not x.startswith(("C.", "POSIX")):
            return "de" if x.startswith("de") else "en"
    return "de"


L = _lang()


def T(de, en):
    return de if L == "de" else en


