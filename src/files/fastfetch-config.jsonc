// ediOS: systemweite fastfetch-Einstellungen (eigene Fassung: ~/.config/fastfetch/config.jsonc)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/fastfetch/edios.txt",
    // Farben aus dem ediOS-Logo: Blau (Ring), Violett (Mitte), helles Lila (E)
    "color": { "1": "38;2;79;109;255", "2": "38;2;139;92;246", "3": "38;2;201;166;255" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;139;92;246", "title": "38;2;79;109;255" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "{pretty-name} ({arch})" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Laufzeit" },
    { "type": "packages", "key": "Pakete" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Bildschirm" },
    { "type": "de", "key": "Desktop" },
    { "type": "wm", "key": "Fenster" },
    { "type": "theme", "key": "Design" },
    { "type": "icons", "key": "Symbole" },
    { "type": "font", "key": "Schrift" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "Prozessor" },
    { "type": "gpu", "key": "Grafik" },
    { "type": "memory", "key": "Arbeitsspeicher" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Speicher (/)", "folders": "/" },
    { "type": "localip", "key": "IP (lokal)" },
    { "type": "battery", "key": "Akku" },
    { "type": "locale", "key": "Sprache" },
    "break",
    "colors"
  ]
}
