#!/usr/bin/env python3
# ediOS-Einrichtung / ediOS Setup (GPL-3.0-or-later)
# Schritt 1 Sprache (+ Tastatur, Zeitzone), Schritt 2 Schrift, Schritt 3 Dock.
#   edios-einrichtung              -> Fenster oeffnen (App-Uebersicht)
#   edios-einrichtung --willkommen -> Autostart: Live-System bis "Fertig"; installiert nur einmal
# Merker in ~/.config/edios/:
#   einrichtung-erledigt   "Fertig" wurde gedrueckt (der Installer uebernimmt ihn ins installierte System)
#   einrichtung-angezeigt  im installierten System schon einmal von selbst gezeigt
#   einrichtung-schritt    nach einem Sprachwechsel hier weitermachen
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

APP_ID = "org.edios.Einrichtung"
CONF_DIR = os.path.join(GLib.get_user_config_dir(), "edios")
STAMP_DONE = os.path.join(CONF_DIR, "einrichtung-erledigt")
STAMP_SHOWN = os.path.join(CONF_DIR, "einrichtung-angezeigt")
STAMP_STEP = os.path.join(CONF_DIR, "einrichtung-schritt")
LIVE = os.path.exists("/etc/conf.d/liveuser")
ROOT_HELPER = "/usr/libexec/edios-sprache-root"


def sys_lang():
    for v in ("LC_ALL", "LC_MESSAGES", "LANG"):
        x = os.environ.get(v, "")
        if x and not x.startswith(("C.", "POSIX")) and x != "C":
            return "de" if x.startswith("de") else "en"
    return "de"


L = sys_lang()


def T(de, en):
    return de if L == "de" else en


