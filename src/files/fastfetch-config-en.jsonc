// ediOS: system-wide fastfetch settings, English (own copy: ~/.config/fastfetch/config.jsonc)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/etc/fastfetch/edios.txt",
    // colours of the ediOS logo
    "color": { "1": "38;2;79;109;255", "2": "38;2;139;92;246", "3": "38;2;201;166;255" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;139;92;246", "title": "38;2;79;109;255" }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "OS", "format": "{pretty-name} ({arch})" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell" },
    { "type": "display", "key": "Display" },
    { "type": "de", "key": "Desktop" },
    { "type": "wm", "key": "WM" },
    { "type": "theme", "key": "Theme" },
    { "type": "icons", "key": "Icons" },
    { "type": "font", "key": "Font" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "swap", "key": "Swap" },
    { "type": "disk", "key": "Disk (/)", "folders": "/" },
    { "type": "localip", "key": "Local IP" },
    { "type": "battery", "key": "Battery" },
    { "type": "locale", "key": "Locale" },
    "break",
    "colors"
  ]
}
